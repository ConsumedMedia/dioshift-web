# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Sender address. Must be on a domain you've verified in Resend.
# For local testing before your domain is verified, use onboarding@resend.dev
CONTACT_FROM_EMAIL="Dioshift <hello@yourdomain.com>"

# Where contact form messages are delivered
CONTACT_TO_EMAIL=you@yourdomain.com

# Supabase (Dashboard > Project Settings > API Keys).
# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
# Use a secret key (sb_secret_...), not the publishable key.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# The public URL of this site, no trailing slash. Stripe Checkout sends
# people back here after paying (or backing out).
# Local: http://localhost:3000   Production: https://dioshift.com
# It also controls search indexing: only SITE_URL=https://dioshift.com (exactly)
# lets search engines in. Anything else (unset, localhost, *.vercel.app) builds
# with robots.txt blocking everything and noindex on every page.
# Canonical URLs, the sitemap and structured data use it too
# (falling back to https://dioshift.com when unset).
SITE_URL=http://localhost:3000

# Stripe (Dashboard > Developers > API keys). Server only.
# Use sk_test_... while testing; admin email links then point at /test/ in the dashboard.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# Signing secret for the webhook endpoint at /api/stripe/webhook.
# Local: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# Production: Dashboard > Developers > Webhooks > your endpoint > Signing secret
# Events to send: checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.deleted, invoice.payment_failed, invoice.paid
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Who gets new signup, cancellation and failed payment emails. Comma separated.
# The first address is also the reply-to on the client's confirmation email.
SIGNUP_NOTIFY_EMAILS=you@yourdomain.com,partner@yourdomain.com

# Upstash Redis for rate limiting the contact and signup forms
# (console.upstash.com > your database > REST API).
# If these are blank, rate limiting is off and every request is allowed.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Optional. Search engine ownership verification meta tags. Leave blank if you
# verify by DNS instead.
# Google Search Console: the content="..." value of the HTML tag method.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: the content="..." value of the msvalidate.01 meta tag.
BING_SITE_VERIFICATION=

# Admin dashboard (/admin).
# Signs the admin session cookie. Use a long random value (at least 32
# characters) and keep it secret. Changing it signs every admin out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=replace_with_a_long_random_value
# The owner. Always an admin, even before anyone is added on /admin/admins,
# and can't be removed there. Sign-in links for every admin go to their own
# address, so this must be an inbox you can read.
ADMIN_BOOTSTRAP_EMAIL=you@yourdomain.com
